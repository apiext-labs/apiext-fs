{
  "ProSettings": {
    "NavTheme": "dark",
    "Layout": "side",
    "ContentWidth": "Fluid",
    "FixedHeader": true,
    "FixSiderbar": true,
    "Title": "文件存储",
    "PrimaryColor": "daybreak",
    "ColorWeak": false,
    "SplitMenus": false,
    "HeaderRender": true,
    "FooterRender": true,
    "MenuRender": true,
    "MenuHeaderRender": true,
    "HeaderHeight": 48
  },
  "UseStaticAccount": true,
  "StaticUser": "",
  "StaticPassword": "",
  "StoreLocation": "App_Data",
  "ConnectionStrings": {
    "DefaultConnection": "Data Source={StoreLocation}/apiext-fs.db"
  },
  "BackgroundJobs": {
    "DefaultMaxParallelPerType": 2,
    "MaxParallelPerType": {
      "DownloadFromS3": 2
    }
  },
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "AllowedHosts": "*"
}
