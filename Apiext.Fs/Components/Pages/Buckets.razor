    // ── Download links (permanent vs temporary) ──────────────────────────────
    private void OpenLinkModal(ExplorerItem item)
    {
        if (string.IsNullOrEmpty(BucketName) || !item.IsObject) return;

        _linkTarget        = item;
        _linkPermanentUrl  = AbsoluteUrl(BuildObjectUrl(BucketName, item.Key));
        _linkExpirySeconds = 3600;
        RebuildTempLink();
    }

    private void CloseLinkModal()
    {
        _linkTarget       = null;
        _linkPermanentUrl = null;
        _linkTempUrl      = null;
    }

    private void OnLinkExpiryChanged(int seconds)
    {
        if (seconds <= 0) return;
        _linkExpirySeconds = seconds;
        RebuildTempLink();
    }

    /// <summary>Regenerates the presigned URL for the currently selected expiry.</summary>
    private void RebuildTempLink()
    {
        if (_linkTarget is null || string.IsNullOrEmpty(BucketName)) return;

        var token = Presigned.Create("GET", BucketName, _linkTarget.Key,
            _userId, _username, _isSuperAdmin, expiresInSeconds: _linkExpirySeconds);

        var relative = AppendQuery(
            BuildObjectUrl(BucketName, _linkTarget.Key),
            $"X-Apiext-Fs-Presign={Uri.EscapeDataString(token.Token)}");

        _linkTempUrl = AbsoluteUrl(relative);
    }

    private async Task CopyPermanentLinkAsync()
    {
        if (_linkPermanentUrl is null) return;

        await JS.InvokeVoidAsync("apiextfsCopy", _linkPermanentUrl);
        Message.Success(_currentBucketPolicy?.IsPublicRead == true
            ? "已复制永久直连地址"
            : "已复制永久地址（私有 Bucket 需携带凭据访问）");
    }

    private async Task CopyTempLinkAsync()
    {
        if (_linkTempUrl is null) return;

        await JS.InvokeVoidAsync("apiextfsCopy", _linkTempUrl);
        Message.Success($"已复制临时链接（{ExpiryLabel(_linkExpirySeconds)}内有效）");
    }

    private static string ExpiryLabel(int seconds) => seconds switch
    {
        >= 604_800 => "7 天",
        >= 86_400  => "24 小时",
        _          => "1 小时"
    };

    private string AbsoluteUrl(string relative)
        => new Uri(new Uri(Nav.BaseUri), relative).ToString();

    private async Task CopyBucketPathAsync(ExplorerItem item)
    {
        var path = $"s3://{item.Key}";
        await JS.InvokeVoidAsync("apiextfsCopy", path);
        Message.Success($"已复制 {path}");
    }

    // ── Rename / move ────────────────────────────────────────────────────────
    private void OpenRename(ExplorerItem item)
    {
        if (!item.IsObject) return;
        _renameTarget = item;
        _renameValue  = item.DisplayName;
        _renameError  = null;
    }

    private void CloseRename()
    {
        if (_renaming) return;
        _renameTarget = null;
        _renameError  = null;
        _renameValue  = string.Empty;
    }

    private async Task ConfirmRenameAsync()
    {
        if (_renameTarget is null || _renaming) return;

        var input = _renameValue.Trim().Replace('\\', '/').TrimStart('/');

        if (string.IsNullOrWhiteSpace(input))
        {
            _renameError = "请输入新名称";
            return;
        }

        if (input.EndsWith('/'))
        {
            _renameError = "名称不能以 / 结尾";
            return;
        }

        if (input.Split('/').Any(seg => seg is "" or "." or ".."))
        {
            _renameError = "名称中不能包含空段、. 或 ..";
            return;
        }

        var sourceKey = _renameTarget.Key;
        // A bare name renames in place; a path moves within the current bucket.
        var destKey = input.Contains('/') ? input : CurrentPrefix + input;

        if (destKey == sourceKey)
        {
            CloseRename();
            return;
        }

        _renaming = true;
        _renameError = null;
        try
        {
            // S3 has no rename primitive: copy to the new key, then delete the old one.
            await ObjectSvc.CopyObjectAsync(new Models.Api.Objects.CopyObjectRequest
            {
                CopySource         = $"/{BucketName}/{sourceKey}",
                DestinationBucket  = BucketName!,
                DestinationKey     = destKey
            });

            await ObjectSvc.DeleteObjectAsync(new Models.Api.Objects.DeleteObjectRequest
            {
                Bucket = BucketName!,
                Key    = sourceKey
            });

            _renaming = false;
            CloseRename();
            await OnParametersSetAsync();
            Message.Success($"已保存为 {destKey}");
        }
        catch (Exception ex)
        {
            _renameError = ex.Message;
            _renaming = false;
        }
    }

    // ── Helpers ───────────────────────────────────────────────────────────────
    private CallerIdentity CallerIdentity() => new() { UserId = _userId, Username = _username, IsSuperAdmin = _isSuperAdmin };

    private string BuildPresignedUrl(string bucket, string key)
    {
        if (_currentBucketPolicy?.IsPublicRead == true)
            return BuildObjectUrl(bucket, key);

        var token = Presigned.Create("GET", bucket, key, _userId, _username, _isSuperAdmin, expiresInSeconds: 3600);
        return $"{BuildObjectUrl(bucket, key)}?X-Apiext-Fs-Presign={Uri.EscapeDataString(token.Token)}";
    }

    private static string BuildObjectUrl(string bucket, string key)
        => $"/{Uri.EscapeDataString(bucket)}/{string.Join('/', key.Split('/').Select(Uri.EscapeDataString))}";

    private static string AppendQuery(string url, string query)
        => url.Contains('?', StringComparison.Ordinal) ? $"{url}&{query}" : $"{url}?{query}";

    private static string AccessPolicyLabel(string accessPolicy)
        => accessPolicy == BucketAccessPolicies.PublicRead
            ? "公开读取"
            : "私有";

    private static string ItemIcon(ExplorerItem item)
    {
        if (item.IsBucket)  return "database";
        if (!item.IsObject) return "folder";
        return ContentIcon(item.ContentType);
    }

    private static string ItemIconClass(ExplorerItem item)
    {
        if (item.IsBucket) return "item-icon-bucket";
        if (!item.IsObject) return "item-icon-folder";
        if (item.ContentType.StartsWith("image/")) return "item-icon-image";
        if (item.ContentType.StartsWith("video/") || item.ContentType.StartsWith("audio/")) return "item-icon-media";
        if (item.ContentType.Contains("pdf")) return "item-icon-pdf";
        return "item-icon-file";
    }

    private static string ContentIcon(string ct)
    {
        if (ct.StartsWith("image/"))  return "file-image";
        if (ct.StartsWith("video/"))  return "video-camera";
        if (ct.StartsWith("audio/"))  return "audio";
        if (ct.Contains("pdf"))       return "file-pdf";
        if (ct.Contains("zip") || ct.Contains("tar") || ct.Contains("gzip") || ct.Contains("7z")) return "file-zip";
        if (ct.StartsWith("text/"))   return "file-text";
        if (ct.Contains("json") || ct.Contains("xml") || ct.Contains("javascript")) return "file-code";
        return "file";
    }

    private static string FormatSize(long bytes)
    {
        if (bytes == 0) return string.Empty;
        string[] s = ["B", "KB", "MB", "GB", "TB"];
        int i = 0; double v = bytes;
        while (v >= 1024 && i < s.Length - 1) { v /= 1024; i++; }
        return i == 0 ? $"{bytes} B" : $"{v:F1} {s[i]}";
    }

    private static string FormatDate(DateTime? dt) =>
        dt.HasValue ? dt.Value.ToString("yyyy-MM-dd HH:mm") : string.Empty;

    private static string StatusIcon(UploadStatus s) => s switch
    {
        UploadStatus.Pending   => "clock-circle",
        UploadStatus.Uploading => "loading",
        UploadStatus.Done      => "check-circle",
        UploadStatus.Skipped   => "minus-circle",
        UploadStatus.Error     => "close-circle",
        _                      => "question-circle"
    };

    private static string StatusLabel(UploadStatus s) => s switch
    {
        UploadStatus.Pending   => "等待中",
        UploadStatus.Uploading => "上传中…",
        UploadStatus.Done      => "完成",
        UploadStatus.Skipped   => "已跳过",
        UploadStatus.Error     => "错误",
        _                      => ""
    };

    private static string StatusClass(UploadStatus s) => s switch
    {
        UploadStatus.Done    => "status-done",
        UploadStatus.Skipped => "status-skip",
        UploadStatus.Error   => "status-error",
        _                    => ""
    };

