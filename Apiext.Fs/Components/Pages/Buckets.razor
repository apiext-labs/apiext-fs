</Modal>

@code {
    // ── Parameters ──────────────────────────────────────────────────────────
    [Parameter] public string? BucketName { get; set; }
    [Parameter] public string? Prefix     { get; set; }

    [CascadingParameter] private Task<AuthenticationState>? AuthState { get; set; }

    // ── Identity / permissions ───────────────────────────────────────────────
    private bool   _loading      = true;
    private string? _error;
    private bool   _isSuperAdmin;
    private bool   _canDelete;
    private bool   _canAdd;
    private bool   _canUpdate;
    private string _userId       = string.Empty;
    private string _username     = string.Empty;
    private BucketPolicyDto? _currentBucketPolicy;
    private bool _bucketPolicySaving;
    private bool _showBucketSettings;
    private string? _bucketSettingsBucket;
    private string _bucketSettingsAccessPolicy = BucketAccessPolicies.Private;
    private string? _bucketSettingsError;

    // ── List state ───────────────────────────────────────────────────────────
    private List<ExplorerItem> _items        = [];
    private HashSet<string>    _selectedKeys  = [];
    private string             _search        = string.Empty;
    private bool               _allSelected;
    private ExplorerItem?      _detail;
    private List<(string Seg, string Href)> _breadcrumbs = [];

    // Paging / sorting (client-side over the loaded listing)
    private const int MaxListPages = 50; // 50k objects safeguard for one folder
    private int    _pageSize   = 50;
    private string _sortMode   = "name-asc";
    private bool   _refreshing;
    private bool   _truncated;

    // Rename / move
    private ExplorerItem? _renameTarget;
    private string        _renameValue = string.Empty;
    private bool          _renaming;
    private string?       _renameError;

    // Download link modal (permanent + temporary)
    private ExplorerItem? _linkTarget;
    private string?       _linkPermanentUrl;
    private string?       _linkTempUrl;
    private int           _linkExpirySeconds = 3600;

    // ── Add bucket modal ─────────────────────────────────────────────────────
    private bool    _showAddBucket;
    private bool    _creatingBucket;

    // ── Create folder modal ──────────────────────────────────────────────────
    private bool    _showCreateFolder;

    // shared modal fields
    private string  _modalName  = string.Empty;
    private string? _modalError;

    // ── Delete ───────────────────────────────────────────────────────────────
    private ExplorerItem? _deleteTarget;
    private bool          _deleteBatch;
    private bool          _deleting;

    // ── Upload ───────────────────────────────────────────────────────────────
    private bool                 _showUpload;
    private bool                 _uploading;
    private bool                 _uploadDone;
    private bool                 _uploadCancelled;
    private CancellationTokenSource? _uploadCts;
    private List<UploadEntry>    _uploadQueue  = [];
    private List<string>         _skippedFiles = [];
    private UploadEntry?         _overwriteFile;
    private TaskCompletionSource<OverwriteChoice>? _overwriteTcs;
    private bool                 _overwriteAll;
    private bool                 _skipAll;

    // ── Import from S3 ───────────────────────────────────────────────────────
    private bool    _showImportFromS3;
    private bool    _importQueueing;
    private string? _importTargetBucket;
    private string? _importQueuedId;
    private string  _importServerUrl     = string.Empty;
    private string  _importUsername      = string.Empty;
    private string  _importKey           = string.Empty;
    private string  _importSourceBucket  = string.Empty;
    private string  _importDuplicateMode = DownloadDuplicateModes.Overwrite;

    // ── Computed ─────────────────────────────────────────────────────────────
    private List<ExplorerItem> _visibleItems
    {
        get
        {
            IEnumerable<ExplorerItem> query = _items;
            if (!string.IsNullOrWhiteSpace(_search))
                query = query.Where(i => i.DisplayName.Contains(_search, StringComparison.OrdinalIgnoreCase));

            // Folders are listed before files, then ordered by the selected key.
            var foldersFirst = query.OrderBy(i => i.IsObject ? 1 : 0);
            return (_sortMode switch
            {
                "name-desc" => foldersFirst.ThenByDescending(i => i.DisplayName, StringComparer.OrdinalIgnoreCase),
                "size-desc" => foldersFirst.ThenByDescending(i => i.Size)
                                         .ThenBy(i => i.DisplayName, StringComparer.OrdinalIgnoreCase),
                "size-asc"  => foldersFirst.ThenBy(i => i.Size)
                                         .ThenBy(i => i.DisplayName, StringComparer.OrdinalIgnoreCase),
                "time-desc" => foldersFirst.ThenByDescending(i => i.Modified ?? DateTime.MinValue)
                                         .ThenBy(i => i.DisplayName, StringComparer.OrdinalIgnoreCase),
                "time-asc"  => foldersFirst.ThenBy(i => i.Modified ?? DateTime.MinValue)
                                         .ThenBy(i => i.DisplayName, StringComparer.OrdinalIgnoreCase),
                _           => foldersFirst.ThenBy(i => i.DisplayName, StringComparer.OrdinalIgnoreCase)
            }).ToList();
        }
    }

    private string CurrentPrefix => string.IsNullOrEmpty(Prefix) ? ""
        : (Prefix.EndsWith('/') ? Prefix : Prefix + "/");

    // ── Lifecycle ────────────────────────────────────────────────────────────
    protected override async Task OnParametersSetAsync()
    {
        _loading      = true;
        _error        = null;
        _detail       = null;
        _selectedKeys.Clear();
        _allSelected  = false;
        _search       = string.Empty;
        _items        = [];
        _canAdd       = false;
        _canUpdate    = false;
        _canDelete    = false;
        _currentBucketPolicy = null;
        ResetUploadState();

        if (AuthState is not null)
        {
            var state     = await AuthState;
            _userId       = state.User.FindFirstValue(ClaimTypes.NameIdentifier) ?? string.Empty;
            _username     = state.User.FindFirstValue(ClaimTypes.Name) ?? _userId;
            _isSuperAdmin = state.User.FindFirstValue("is_super_admin") == "true";
        }

        BuildBreadcrumbs();

        try
        {
            if (BucketName is null)
                await LoadBucketsAsync();
            else
                await LoadObjectsAsync();
        }
        catch (Exception ex)
        {
            _error = ex.Message;
        }

        _loading = false;
    }

    private void BuildBreadcrumbs()
    {
        _breadcrumbs.Clear();
        if (BucketName is null || string.IsNullOrEmpty(Prefix)) return;
        var segments = Prefix.Split('/', StringSplitOptions.RemoveEmptyEntries);
        var accum    = string.Empty;
        foreach (var seg in segments)
        {
            accum = string.IsNullOrEmpty(accum) ? seg + "/" : accum + seg + "/";
            _breadcrumbs.Add((seg, $"/_apiextfs/buckets/{BucketName}/{accum}"));
        }
    }

    // ── Load buckets ─────────────────────────────────────────────────────────
    private async Task LoadBucketsAsync()
    {
        var identity  = CallerIdentity();
        var response  = await BucketSvc.ListBucketsAsync(identity.UserId);
        var policyByBucket = await BucketPolicies.GetPoliciesAsync(
            response.Buckets.Select(b => b.Name));
        var accessible = new List<ExplorerItem>();
        foreach (var b in response.Buckets)
        {
            var policy = policyByBucket.TryGetValue(b.Name, out var p)
                ? p.AccessPolicy
                : BucketAccessPolicies.Private;

            if (identity.IsSuperAdmin) { accessible.Add(BucketItem(b, policy)); continue; }
            var acl = await Authz.CheckAccessAsync(identity, b.Name, BucketPermission.Read);
            if (acl == AclCheckResult.Allowed) accessible.Add(BucketItem(b, policy));
        }
        _items = accessible.OrderBy(i => i.DisplayName, StringComparer.OrdinalIgnoreCase).ToList();
    }

    private static ExplorerItem BucketItem(BucketEntry b, string accessPolicy) => new()
    {
        Key         = b.Name,
        DisplayName = b.Name,
        IsObject    = false,
        IsBucket    = true,
        AccessPolicy = accessPolicy,
        Modified    = DateTime.TryParse(b.CreationDate, out var dt) ? dt.ToUniversalTime() : null,
        NavHref     = $"/_apiextfs/buckets/{b.Name}"
    };

    // ── Load objects ─────────────────────────────────────────────────────────
    private async Task LoadObjectsAsync()
    {
        var identity = CallerIdentity();
        _currentBucketPolicy = await BucketPolicies.GetPolicyAsync(BucketName!);

        if (!identity.IsSuperAdmin)
        {
            var read = await Authz.CheckAccessAsync(identity, BucketName!, BucketPermission.Read);
            if (read != AclCheckResult.Allowed) { _error = "You do not have read access to this bucket."; return; }
        }

        _canDelete = identity.IsSuperAdmin || (await Authz.CheckAccessAsync(identity, BucketName!, BucketPermission.Delete)) == AclCheckResult.Allowed;
        _canAdd    = identity.IsSuperAdmin || (await Authz.CheckAccessAsync(identity, BucketName!, BucketPermission.Add))    == AclCheckResult.Allowed;
        _canUpdate = identity.IsSuperAdmin || (await Authz.CheckAccessAsync(identity, BucketName!, BucketPermission.Update)) == AclCheckResult.Allowed;

        var prefix = CurrentPrefix;
        var list = new List<ExplorerItem>();
        var seenFolders = new HashSet<string>(StringComparer.Ordinal);
        string? token = null;
        var pages = 0;
        _truncated = false;

        // Follow continuation tokens so folders holding more than 1000 objects
        // are listed completely instead of being silently truncated.
        do
        {
            var resp = await BucketSvc.ListObjectsV2Async(BucketName!, new ListObjectsV2Request
            {
                Prefix = prefix,
                Delimiter = "/",
                MaxKeys = 1000,
                ContinuationToken = token
            });

            foreach (var cp in resp.CommonPrefixes)
            {
                if (!seenFolders.Add(cp.Prefix)) continue;
                var display = cp.Prefix.TrimEnd('/');
                if (!string.IsNullOrEmpty(prefix)) display = display[prefix.Length..];
                list.Add(new ExplorerItem
                {
                    Key         = cp.Prefix,
                    DisplayName = display,
                    IsObject    = false,
                    IsBucket    = false,
                    NavHref     = $"/_apiextfs/buckets/{BucketName}/{cp.Prefix}"
                });
            }

            foreach (var obj in resp.Contents)
            {
                if (obj.Key == prefix) continue;
                var displayName = obj.Key;
                if (!string.IsNullOrEmpty(prefix) && displayName.StartsWith(prefix))
                    displayName = displayName[prefix.Length..];

                list.Add(new ExplorerItem
                {
                    Key          = obj.Key,
                    DisplayName  = displayName,
                    IsObject     = true,
                    Size         = obj.Size,
                    Modified     = DateTime.TryParse(obj.LastModified, out var dt) ? dt.ToUniversalTime() : null,
                    // ListObjects already carries size/ETag; deriving the content type
                    // from the extension avoids one HeadObject per row (N+1).
                    ContentType  = GuessContentType(obj.Key),
                    ETag         = obj.ETag,
                    StorageClass = obj.StorageClass
                });
            }

            token = resp.IsTruncated ? resp.NextContinuationToken : null;
            pages++;
        }
        while (token is not null && pages < MaxListPages);

        _truncated = token is not null;
        _items = list;
    }

    private static string GuessContentType(string key)
    {
        try { return MimeTypes.GetMimeType(key); }
        catch { return "application/octet-stream"; }
    }

    // ── Selection ────────────────────────────────────────────────────────────
    private void ToggleSelect(ExplorerItem item, bool value)
    {
        if (value) _selectedKeys.Add(item.Key);
        else       _selectedKeys.Remove(item.Key);
        _allSelected = _items.Count > 0 && _items.All(i => _selectedKeys.Contains(i.Key));
    }

    private void OnSelectAllChanged(bool value)
    {
        _allSelected = value;
        _selectedKeys.Clear();
        if (_allSelected) foreach (var i in _items) _selectedKeys.Add(i.Key);
    }

    // Table row click → toggle detail panel
    private void OnRowClick(AntDesign.TableModels.RowData<ExplorerItem> row)
        => ShowDetail(row.Data);

    // Double-click row → open item (folder / preview), matching original explorer behavior
    private Dictionary<string, object> GetRowAttributes(AntDesign.TableModels.RowData<ExplorerItem> row)
        => new()
        {
            ["ondblclick"] = EventCallback.Factory.Create(this, () => OpenItem(row.Data))
        };

    private string GetRowClassName(AntDesign.TableModels.RowData<ExplorerItem> row)
        => _detail?.Key == row.Data.Key ? "apiextfs-row-active" : string.Empty;

    private string EmptyDescription()
    {
        if (!string.IsNullOrEmpty(_search))
            return "没有匹配的项目，请尝试其他搜索关键词。";

        if (BucketName is null)
            return "还没有 Bucket。创建后即可开始上传和管理对象。";

        return "当前位置为空。可以新建文件夹，或上传文件。";
    }

    // ── Detail ───────────────────────────────────────────────────────────────
    private void ShowDetail(ExplorerItem item) => _detail = _detail?.Key == item.Key ? null : item;
    private void CloseDetail() => _detail = null;

    private void OpenBucketSettings(string bucketName, string accessPolicy)
    {
        if (!_isSuperAdmin)
            return;

        _bucketSettingsBucket = bucketName;
        _bucketSettingsAccessPolicy = accessPolicy is BucketAccessPolicies.PublicRead
            ? BucketAccessPolicies.PublicRead
            : BucketAccessPolicies.Private;
        _bucketSettingsError = null;
        _showBucketSettings = true;
    }

    private void CloseBucketSettings()
    {
        if (_bucketPolicySaving)
            return;

        _showBucketSettings = false;
        _bucketSettingsError = null;
    }

    private async Task SaveBucketSettingsAsync()
    {
        if (!_isSuperAdmin || string.IsNullOrWhiteSpace(_bucketSettingsBucket))
            return;

        var requested = _bucketSettingsAccessPolicy;
        if (requested is not BucketAccessPolicies.Private and not BucketAccessPolicies.PublicRead)
            return;

        _bucketPolicySaving = true;
        _bucketSettingsError = null;

        try
        {
            var bucketName = _bucketSettingsBucket;
            await BucketPolicies.SetAccessPolicyAsync(bucketName, requested);

            if (BucketName == bucketName)
            {
                _currentBucketPolicy = new BucketPolicyDto
                {
                    BucketName = bucketName,
                    AccessPolicy = requested
                };
            }

            foreach (var item in _items.Where(i => i.IsBucket && i.Key == bucketName))
                item.AccessPolicy = requested;

            if (_detail?.IsBucket == true && _detail.Key == bucketName)
                _detail.AccessPolicy = requested;

            _showBucketSettings = false;
            Message.Success("访问策略已更新");
        }
        catch (Exception ex)
        {
            _bucketSettingsError = ex.Message;
        }
        finally
        {
            _bucketPolicySaving = false;
        }
    }

    private FilePreviewModal? _previewModal;

    private void OpenItem(ExplorerItem item)
    {
        if (!item.IsObject)
        {
            Nav.NavigateTo(item.NavHref);
            return;
        }

        var previewItem = new FilePreviewModal.PreviewItem
        {
            DisplayName = item.DisplayName,
            ContentType = item.ContentType,
            PreviewUrl  = BuildPresignedUrl(BucketName!, item.Key)
        };

        var allPreviewItems = _visibleItems
            .Where(i => i.IsObject)
            .Select(i => i.Key == item.Key ? previewItem : new FilePreviewModal.PreviewItem
            {
                DisplayName = i.DisplayName,
                ContentType = i.ContentType,
                PreviewUrl  = BuildPresignedUrl(BucketName!, i.Key)
            })
            .ToList();

        _ = _previewModal?.OpenAsync(previewItem, allPreviewItems);
    }

    // ── Download ─────────────────────────────────────────────────────────────
    private async Task DownloadAsync(ExplorerItem item)
    {
        if (!item.IsObject || BucketName is null) return;
        var url = AppendQuery(BuildPresignedUrl(BucketName, item.Key), "download=1");
        await JS.InvokeVoidAsync("apiextfsDownload", url, item.DisplayName);
    }

    private async Task DownloadZipAsync()
    {
        if (_selectedKeys.Count == 0) return;

        if (BucketName is null)
        {
            await JS.InvokeVoidAsync("apiextfsDownloadZip", string.Empty, _selectedKeys.ToArray(), "buckets.zip");
        }
        else
        {
            var keys    = _selectedKeys.ToArray();
            var zipName = (string.IsNullOrEmpty(Prefix) ? BucketName : Prefix.Trim('/')) + ".zip";
            await JS.InvokeVoidAsync("apiextfsDownloadZip", BucketName, keys, zipName);
        }
    }

    // ── Add bucket ───────────────────────────────────────────────────────────
    private void OpenAddBucket()
    {
        if (!_isSuperAdmin || _creatingBucket)
            return;

        _modalName = string.Empty;
        _modalError = null;
        _showAddBucket = true;
    }

    private void CloseAddBucket()
    {
        if (_creatingBucket)
            return;

        _showAddBucket = false;
    }

    private async Task OnAddBucketKeyDown(KeyboardEventArgs e)
    {
        if (e.Key == "Enter" && !string.IsNullOrWhiteSpace(_modalName)) await CreateBucketAsync();
        else if (e.Key == "Escape") CloseAddBucket();
    }

    private async Task CreateBucketAsync()
    {
        if (!_isSuperAdmin || _creatingBucket)
            return;

        _modalError = null;
        var name = _modalName.Trim();
        if (string.IsNullOrEmpty(name))
        {
            _modalError = "Bucket 名称不能为空。";
            return;
        }

        _creatingBucket = true;
        try
        {
            await BucketSvc.CreateBucketAsync(name, region: null, ownerId: _userId);
            _showAddBucket = false;
            await LoadBucketsAsync();
            Message.Success($"Bucket {name} 已创建");
        }
        catch (Exception ex) { _modalError = ex.Message; }
        finally { _creatingBucket = false; }
    }

    // ── Create folder ────────────────────────────────────────────────────────
    private void OpenCreateFolder()  { _modalName = string.Empty; _modalError = null; _showCreateFolder = true; }
    private void CloseCreateFolder() { _showCreateFolder = false; }

    private async Task OnCreateFolderKeyDown(KeyboardEventArgs e)
    {
        if (e.Key == "Enter" && !string.IsNullOrWhiteSpace(_modalName)) await NavigateToVirtualFolder();
        else if (e.Key == "Escape") CloseCreateFolder();
    }

    private async Task NavigateToVirtualFolder()
    {
        _modalError = null;
        var name = _modalName.Trim().Trim('/');
        if (string.IsNullOrEmpty(name)) return;

        // Reject names with path separators
        if (name.Contains('/')) { _modalError = "文件夹名称不能包含 '/'。"; return; }

        // Check for duplicate at current level
        var folderKey = CurrentPrefix + name + "/";
        var exists    = _items.Any(i => !i.IsObject && i.Key == folderKey);
        if (exists) { _modalError = "同名文件夹已存在。"; return; }

        CloseCreateFolder();
        Nav.NavigateTo($"/_apiextfs/buckets/{BucketName}/{folderKey}");
        await Task.CompletedTask;
    }

    // ── Page-level drag-and-drop ──────────────────────────────────────────────
    private InputFile?  _inputFileRef;
    private ElementReference _pageDropOverlayRef;
    private bool        _dropRegistered;
    private bool        _pendingApplyDrop;
    private DotNetObjectReference<Buckets>? _dropRef;

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        // Re-register whenever we enter a bucket with upload rights.
        var shouldRegister = BucketName is not null && (_canAdd || _canUpdate);
        if (shouldRegister && !_dropRegistered)
            await RegisterDropAsync();
        else if (!shouldRegister && _dropRegistered)
            await UnregisterDropAsync();

        if (_pendingApplyDrop && _inputFileRef is not null)
        {
            _pendingApplyDrop = false;
            await JS.InvokeVoidAsync("apiextfsApplyDropFiles", _inputFileRef.Element);
        }
    }

    private async Task RegisterDropAsync()
    {
        _dropRef?.Dispose();
        _dropRef = DotNetObjectReference.Create(this);
        await JS.InvokeVoidAsync("apiextfsRegisterDrop", _dropRef, _pageDropOverlayRef);
        _dropRegistered = true;
    }

    private async Task UnregisterDropAsync()
    {
        try { await JS.InvokeVoidAsync("apiextfsUnregisterDrop"); } catch { }
        _dropRef?.Dispose();
        _dropRef = null;
        _dropRegistered = false;
    }

    [JSInvokable]
    public void OnPageDrop()
    {
        OpenUpload();
        _pendingApplyDrop = true;
        StateHasChanged();
    }

    public async ValueTask DisposeAsync()
    {
        _dropRef?.Dispose();
        try { await JS.InvokeVoidAsync("apiextfsUnregisterDrop"); } catch { }
    }

