<Modal Title="获取下载链接"
       Visible="_linkTarget is not null"
       OnCancel="CloseLinkModal"
       Footer="null"
       Width="640"
       MaskClosable="false">
    @if (_linkTarget is not null)
    {
        <div class="apiextfs-link-head">
            <Icon Type="@ItemIcon(_linkTarget)" Class="@ItemIconClass(_linkTarget)" />
            <AntDesign.Text Strong Class="apiextfs-link-key">@_linkTarget.Key</AntDesign.Text>
        </div>

        <div class="apiextfs-field-block apiextfs-link-section">
            <label class="apiextfs-field-label">永久地址（公开直连）</label>
            <div class="apiextfs-link-row">
                <Input Value="@_linkPermanentUrl" ReadOnly />
                <Button Icon="copy" OnClick="CopyPermanentLinkAsync">复制</Button>
            </div>
            @if (_currentBucketPolicy?.IsPublicRead == true)
            {
                <AntDesign.Text Type="@TextElementType.Secondary" Class="apiextfs-link-hint">
                    当前 Bucket 为「公开读取」：匿名即可访问，地址长期有效。
                </AntDesign.Text>
            }
            else
            {
                <AntDesign.Text Type="@TextElementType.Secondary" Class="apiextfs-link-hint">
                    当前 Bucket 为「私有」：此地址需要携带凭据访问；如需匿名分享请使用下方临时地址。
                </AntDesign.Text>
            }
        </div>

        <div class="apiextfs-field-block">
            <label class="apiextfs-field-label">临时地址（预签名）</label>
            <div class="apiextfs-link-row">
                <Input Value="@_linkTempUrl" ReadOnly />
                <Select TItemValue="int" TItem="int"
                        Value="_linkExpirySeconds"
                        ValueChanged="OnLinkExpiryChanged"
                        Style="width:112px;flex:none">
                    <SelectOptions>
                        <SelectOption TItemValue="int" TItem="int" Value="@(3600)" Label="1 小时" />
                        <SelectOption TItemValue="int" TItem="int" Value="@(86400)" Label="24 小时" />
                        <SelectOption TItemValue="int" TItem="int" Value="@(604800)" Label="7 天" />
                    </SelectOptions>
                </Select>
                <Button Type="@ButtonType.Primary" Icon="copy" OnClick="CopyTempLinkAsync">复制</Button>
            </div>
            <AntDesign.Text Type="@TextElementType.Secondary" Class="apiextfs-link-hint">
                到期自动失效；服务重启后所有已生成的临时链接失效。
            </AntDesign.Text>
        </div>

        <div class="apiextfs-modal-footer">
            <Button OnClick="CloseLinkModal">关闭</Button>
        </div>
    }
</Modal>

