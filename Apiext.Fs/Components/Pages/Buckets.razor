@page "/_apiextfs/buckets"
@page "/_apiextfs/buckets/{BucketName}"
@page "/_apiextfs/buckets/{BucketName}/{**Prefix}"
@layout AppLayout
@attribute [Microsoft.AspNetCore.Authorization.Authorize]
@using System.Security.Claims
@using Apiext.Fs.Models.Api.Buckets
@using Apiext.Fs.Models.Entities
@using Apiext.Fs.Services.BackgroundJobs
@using MimeKit
@using Microsoft.AspNetCore.Components.Forms
@inject IS3BucketService BucketSvc
@inject IS3ObjectService ObjectSvc
@inject IAuthorizationProvider Authz
@inject IBucketPolicyService BucketPolicies
@inject IPresignedUrlService Presigned
@inject IBackgroundJobQueue JobQueue
@inject NavigationManager Nav
@inject IJSRuntime JS
@inject MessageService Message
@using AntDesign.ProLayout
@implements IAsyncDisposable

<PageTitle>@(BucketName is null ? "Buckets" : BucketName) — Apiext.Fs</PageTitle>

<PageContainer Title="@(BucketName ?? "Buckets")">
    <Breadcrumb>
        @if (BucketName is not null)
        {
            @* Outer <Breadcrumb> is PageContainer's render fragment slot;
               inner <Breadcrumb> is the actual AntDesign component. *@
            <Breadcrumb>
                <BreadcrumbItem Href="/_apiextfs/buckets">
                    <Icon Type="cloud-server" /> Buckets
                </BreadcrumbItem>
                <BreadcrumbItem Href="@($"/_apiextfs/buckets/{BucketName}")">@BucketName</BreadcrumbItem>
                @foreach (var (seg, href) in _breadcrumbs)
                {
                    <BreadcrumbItem Href="@href">@seg</BreadcrumbItem>
                }
            </Breadcrumb>
        }
    </Breadcrumb>
    <Content>
        @if (BucketName is null)
        {
            <AntDesign.Text Type="@TextElementType.Secondary">管理存储 Bucket，打开后可浏览对象。</AntDesign.Text>
        }
        else if (string.IsNullOrEmpty(CurrentPrefix))
        {
            <AntDesign.Text Type="@TextElementType.Secondary">@_visibleItems.Count 个项目位于当前 Bucket。</AntDesign.Text>
        }
        else
        {
            <AntDesign.Text Type="@TextElementType.Secondary">@_visibleItems.Count 个项目位于 @CurrentPrefix 下</AntDesign.Text>
        }
    </Content>
    <ChildContent>

<div class="page-drop-zone">

<div @ref="_pageDropOverlayRef" class="page-drop-overlay">⬆ 拖放文件以上传</div>

<Card Class="apiextfs-explorer-card" BodyStyle="padding:0">
    <!-- ── Toolbar ───────────────────────────────────────────────────── -->
    <div class="apiextfs-bucket-toolbar">
        <Space Wrap>
            <SpaceItem>
                <Search Placeholder="搜索当前列表…" @bind-Value="_search" Style="width:240px" AllowClear />
            </SpaceItem>
            @if (_items.Count > 1)
            {
                <SpaceItem>
                    <Select TItemValue="string" TItem="string" @bind-Value="_sortMode" Style="width:132px">
                        <SelectOptions>
                            <SelectOption TItemValue="string" TItem="string" Value="@("name-asc")" Label="名称 A→Z" />
                            <SelectOption TItemValue="string" TItem="string" Value="@("name-desc")" Label="名称 Z→A" />
                            <SelectOption TItemValue="string" TItem="string" Value="@("time-desc")" Label="最新优先" />
                            <SelectOption TItemValue="string" TItem="string" Value="@("time-asc")" Label="最早优先" />
                            <SelectOption TItemValue="string" TItem="string" Value="@("size-desc")" Label="大小 大→小" />
                            <SelectOption TItemValue="string" TItem="string" Value="@("size-asc")" Label="大小 小→大" />
                        </SelectOptions>
                    </Select>
                </SpaceItem>
            }
            <SpaceItem>
                <Tooltip Title="@("刷新")">
                    <Button Icon="reload" Loading="_refreshing" OnClick="RefreshAsync" />
                </Tooltip>
            </SpaceItem>
            <SpaceItem>
                <AntDesign.Text Type="@TextElementType.Secondary" Class="apiextfs-item-count">
                    @_visibleItems.Count 个项目
                    @if (_selectedKeys.Count > 0)
                    {
                        <span> · 已选 @_selectedKeys.Count</span>
                    }
                    @if (_truncated)
                    {
                        <span> · 仅显示前 @_items.Count 项</span>
                    }
                </AntDesign.Text>
            </SpaceItem>
        </Space>
        <Space Wrap>
            @if (BucketName is not null && _isSuperAdmin && _currentBucketPolicy is not null)
            {
                <SpaceItem>
                    <Button Icon="setting" OnClick="() => OpenBucketSettings(BucketName!, _currentBucketPolicy.AccessPolicy)">设置</Button>
                </SpaceItem>
            }
            @if (BucketName is null && _isSuperAdmin)
            {
                <SpaceItem>
                    <Button Type="@ButtonType.Primary" Icon="plus" OnClick="OpenAddBucket">新建 Bucket</Button>
                </SpaceItem>
            }
            @if (BucketName is not null && _canAdd)
            {
                <SpaceItem>
                    <Button Icon="folder-add" OnClick="OpenCreateFolder">新建文件夹</Button>
                </SpaceItem>
                <SpaceItem>
                    <Button Type="@ButtonType.Primary" Icon="upload" OnClick="OpenUpload">上传</Button>
                </SpaceItem>
            }
            @if (_selectedKeys.Count > 0 && BucketName is not null)
            {
                <SpaceItem>
                    <Button Icon="file-zip" OnClick="DownloadZipAsync">下载 Zip（@_selectedKeys.Count）</Button>
                </SpaceItem>
                @if (_canDelete)
                {
                    <SpaceItem>
                        <Button Danger Icon="delete" OnClick="RequestDeleteSelected">删除（@_selectedKeys.Count）</Button>
                    </SpaceItem>
                }
            }
        </Space>
    </div>

    <!-- ── List ──────────────────────────────────────────────────────── -->
    <div class="apiextfs-explorer-body">
        @if (_error is not null)
        {
            <Alert Type="@AlertType.Error" Message="@_error" ShowIcon="true" Class="apiextfs-explorer-alert" />
        }
        else if (!_loading && _visibleItems.Count == 0)
        {
            <div class="apiextfs-explorer-empty">
                <Empty Description="@EmptyDescription()">
                    <ChildContent>
                        @if (string.IsNullOrEmpty(_search))
                        {
                            @if (BucketName is not null && _canAdd)
                            {
                                <div class="apiextfs-explorer-empty-hint">
                                    也可直接把文件拖到此页面上传
                                </div>
                            }
                            <Space>
                                @if (BucketName is null && _isSuperAdmin)
                                {
                                    <SpaceItem>
                                        <Button Type="@ButtonType.Primary" Icon="plus" OnClick="OpenAddBucket">新建 Bucket</Button>
                                    </SpaceItem>
                                }
                                @if (BucketName is not null && _canAdd)
                                {
                                    <SpaceItem>
                                        <Button Icon="folder-add" OnClick="OpenCreateFolder">新建文件夹</Button>
                                    </SpaceItem>
                                    <SpaceItem>
                                        <Button Type="@ButtonType.Primary" Icon="upload" OnClick="OpenUpload">上传文件</Button>
                                    </SpaceItem>
                                }
                            </Space>
                        }
                    </ChildContent>
                </Empty>
            </div>
        }
        else
        {
            <Table TItem="ExplorerItem"
                   DataSource="_visibleItems"
                   Loading="_loading || _refreshing"
                   PageSize="_pageSize"
                   HidePagination="_visibleItems.Count <= _pageSize"
                   PaginationPosition="bottomRight"
                   Size="@TableSize.Middle"
                   OnRowClick="OnRowClick"
                   OnRow="GetRowAttributes"
                   RowClassName="GetRowClassName"
                   Class="apiextfs-explorer-table"
                   Responsive>
                <Column TData="bool" Width="48" Align="ColumnAlign.Center">
                    <TitleTemplate>
                        <Checkbox Checked="_allSelected" CheckedChanged="OnSelectAllChanged" />
                    </TitleTemplate>
                    <ChildContent>
                        <span @onclick:stopPropagation="true">
                            <Checkbox Checked="_selectedKeys.Contains(context.Key)"
                                      CheckedChanged="v => ToggleSelect(context, v)" />
                        </span>
                    </ChildContent>
                </Column>
                <Column TData="string" Width="48" Align="ColumnAlign.Center">
                    <span class="apiextfs-item-icon @ItemIconClass(context)">
                        <Icon Type="@ItemIcon(context)" />
                    </span>
                </Column>
                <Column TData="string" Title="名称">
                    <a class="apiextfs-item-name"
                       @onclick:preventDefault
                       @onclick:stopPropagation="true"
                       @onclick="() => OpenItem(context)">@context.DisplayName</a>
                </Column>
                <Column TData="long" Title="大小" Width="120">
                    <span class="apiextfs-item-meta">@(context.IsObject ? FormatSize(context.Size) : "—")</span>
                </Column>
                <Column TData="DateTime?" Title="修改时间" Width="170">
                    <span class="apiextfs-item-meta">@FormatDate(context.Modified)</span>
                </Column>
                <ActionColumn Title="操作" Width="200" Align="ColumnAlign.Right">
                    <span @onclick:stopPropagation="true" class="apiextfs-row-actions">
                        <Space Size="@("0")">
                            @if (context.IsObject)
                            {
                                <SpaceItem>
                                    <Tooltip Title="@("下载")">
                                        <Button Type="@ButtonType.Text" Icon="download" OnClick="() => DownloadAsync(context)" />
                                    </Tooltip>
                                </SpaceItem>
                                <SpaceItem>
                                    <Tooltip Title="@("获取链接")">
                                        <Button Type="@ButtonType.Text" Icon="link" OnClick="() => OpenLinkModal(context)" />
                                    </Tooltip>
                                </SpaceItem>
                                @if (_canAdd || _canUpdate)
                                {
                                    <SpaceItem>
                                        <Tooltip Title="@("重命名 / 移动")">
                                            <Button Type="@ButtonType.Text" Icon="edit" OnClick="() => OpenRename(context)" />
                                        </Tooltip>
                                    </SpaceItem>
                                }
                                @if (_canDelete)
                                {
                                    <SpaceItem>
                                        <Tooltip Title="@("删除")">
                                            <Button Type="@ButtonType.Text" Danger Icon="delete" OnClick="() => RequestDeleteSingle(context)" />
                                        </Tooltip>
                                    </SpaceItem>
                                }
                            }
                            else if (context.IsBucket)
                            {
                                <SpaceItem>
                                    <Tooltip Title="@("打开")">
                                        <Button Type="@ButtonType.Text" Icon="folder-open"
                                                OnClick="() => OpenItem(context)" />
                                    </Tooltip>
                                </SpaceItem>
                                <SpaceItem>
                                    <Tooltip Title="@("复制 S3 路径")">
                                        <Button Type="@ButtonType.Text" Icon="link" OnClick="() => CopyBucketPathAsync(context)" />
                                    </Tooltip>
                                </SpaceItem>
                                @if (_isSuperAdmin)
                                {
                                    <SpaceItem>
                                        <Tooltip Title="@("设置")">
                                            <Button Type="@ButtonType.Text" Icon="setting" OnClick="() => OpenBucketSettings(context.Key, context.AccessPolicy)" />
                                        </Tooltip>
                                    </SpaceItem>
                                    <SpaceItem>
                                        <Tooltip Title="@("删除 Bucket")">
                                            <Button Type="@ButtonType.Text" Danger Icon="delete" OnClick="() => RequestDeleteSingle(context)" />
                                        </Tooltip>
                                    </SpaceItem>
                                }
                            }
                            else
                            {
                                <SpaceItem>
                                    <Tooltip Title="@("打开")">
                                        <Button Type="@ButtonType.Text" Icon="folder-open" OnClick="() => OpenItem(context)" />
                                    </Tooltip>
                                </SpaceItem>
                                @if (_canDelete)
                                {
                                    <SpaceItem>
                                        <Tooltip Title="@("删除文件夹")">
                                            <Button Type="@ButtonType.Text" Danger Icon="delete" OnClick="() => RequestDeleteSingle(context)" />
                                        </Tooltip>
                                    </SpaceItem>
                                }
                            }
                        </Space>
                    </span>
                </ActionColumn>
            </Table>
        }
    </div>
</Card>

<!-- ── Detail drawer ─────────────────────────────────────────────── -->
<Drawer Closable Visible="_detail is not null" Title="@(_detail?.DisplayName ?? "详情")" OnClose="_ => CloseDetail()" Width="380">
    @if (_detail is not null)
    {
        <div class="apiextfs-detail-icon @ItemIconClass(_detail)"><Icon Type="@ItemIcon(_detail)" /></div>
        <Descriptions Column="1" Bordered Size="@DescriptionsSize.Small">
            @if (_detail.IsObject)
            {
                <DescriptionsItem Title="完整 Key"><AntDesign.Text Code>@_detail.Key</AntDesign.Text></DescriptionsItem>
                <DescriptionsItem Title="内容类型">@_detail.ContentType</DescriptionsItem>
                <DescriptionsItem Title="大小">@FormatSize(_detail.Size) (@_detail.Size.ToString("N0") bytes)</DescriptionsItem>
                <DescriptionsItem Title="最后修改">@_detail.Modified?.ToString("yyyy-MM-dd HH:mm:ss") UTC</DescriptionsItem>
                <DescriptionsItem Title="ETag"><AntDesign.Text Code>@_detail.ETag</AntDesign.Text></DescriptionsItem>
                @if (_detail.StorageClass is not null)
                {
                    <DescriptionsItem Title="存储类型">@_detail.StorageClass</DescriptionsItem>
                }
            }
            else
            {
                <DescriptionsItem Title="名称">@_detail.DisplayName</DescriptionsItem>
                @if (_detail.Modified.HasValue)
                {
                    <DescriptionsItem Title="创建时间">@_detail.Modified?.ToString("yyyy-MM-dd HH:mm:ss") UTC</DescriptionsItem>
                }
                <DescriptionsItem Title="类型">@(_detail.IsBucket ? "Bucket" : "文件夹")</DescriptionsItem>
                @if (_detail.IsBucket)
                {
                    <DescriptionsItem Title="访问权限">@AccessPolicyLabel(_detail.AccessPolicy)</DescriptionsItem>
                }
            }
        </Descriptions>

        <div class="apiextfs-mt-2">
            <Space Direction="@SpaceDirection.Vertical" Style="width:100%">
                @if (_detail.IsObject)
                {
                    <SpaceItem>
                        <Button Type="@ButtonType.Primary" Icon="download" Block OnClick="() => DownloadAsync(_detail)">下载</Button>
                    </SpaceItem>
                    <SpaceItem>
                        <Button Icon="link" Block OnClick="() => OpenLinkModal(_detail)">获取链接</Button>
                    </SpaceItem>
                    @if (_canAdd || _canUpdate)
                    {
                        <SpaceItem>
                            <Button Icon="edit" Block OnClick="() => OpenRename(_detail)">重命名 / 移动</Button>
                        </SpaceItem>
                    }
                    @if (_canDelete)
                    {
                        <SpaceItem>
                            <Button Danger Icon="delete" Block OnClick="() => RequestDeleteSingle(_detail)">删除</Button>
                        </SpaceItem>
                    }
                }
                else if (!_detail.IsBucket)
                {
                    <SpaceItem>
                        <Button Type="@ButtonType.Primary" Icon="folder-open" Block Href="@_detail.NavHref">打开文件夹</Button>
                    </SpaceItem>
                    @if (_canDelete)
                    {
                        <SpaceItem>
                            <Button Danger Icon="delete" Block OnClick="() => RequestDeleteSingle(_detail)">删除</Button>
                        </SpaceItem>
                    }
                }
                else
                {
                    <SpaceItem>
                        <Button Type="@ButtonType.Primary" Icon="folder-open" Block Href="@_detail.NavHref">打开 Bucket</Button>
                    </SpaceItem>
                    @if (_isSuperAdmin)
                    {
                        <SpaceItem>
                            <Button Icon="setting" Block OnClick="() => OpenBucketSettings(_detail.Key, _detail.AccessPolicy)">设置</Button>
                        </SpaceItem>
                    }
                    <SpaceItem>
                        <Button Icon="cloud-download" Block OnClick="() => OpenImportFromS3(_detail.Key)">从 S3 导入</Button>
                    </SpaceItem>
                    @if (_isSuperAdmin)
                    {
                        <SpaceItem>
                            <Button Danger Icon="delete" Block OnClick="() => RequestDeleteSingle(_detail)">删除</Button>
                        </SpaceItem>
                    }
                }
            </Space>
        </div>
    }
</Drawer>

<!-- ── File preview modal ───────────────────────────────────────────── -->
<FilePreviewModal @ref="_previewModal" />

</div> <!-- /page-drop-zone -->
    </ChildContent>
</PageContainer>

<!-- ── Add bucket modal ──────────────────────────────────────────── -->
<Modal Title="新建 Bucket"
       Visible="_showAddBucket"
       OnOk="CreateBucketAsync"
       OnCancel="_ => CloseAddBucket()"
       OkText="@("创建")"
       CancelText="@("取消")"
       ConfirmLoading="_creatingBucket"
       MaskClosable="false">
    @if (_modalError is not null)
    {
        <Alert Type="@AlertType.Error" Message="@_modalError" ShowIcon="true" Class="apiextfs-mb-2" />
    }
    <Input @bind-Value="_modalName"
           BindOnInput="true"
           Disabled="_creatingBucket"
           Placeholder="my-bucket"
           OnPressEnter="CreateBucketAsync" />
</Modal>

<!-- ── Create folder modal ───────────────────────────────────────── -->
<Modal Title="新建文件夹"
       Visible="_showCreateFolder"
       OnOk="NavigateToVirtualFolder"
       OnCancel="_ => CloseCreateFolder()"
       OkText="@("打开")"
       CancelText="@("取消")">
    @if (_modalError is not null)
    {
        <Alert Type="@AlertType.Error" Message="@_modalError" ShowIcon="true" Class="apiextfs-mb-2" />
    }
    <Input @bind-Value="_modalName" Placeholder="my-folder" OnPressEnter="NavigateToVirtualFolder" />
</Modal>

<!-- ══════════════════════════════════════════════════════════════════
     Upload modal
══════════════════════════════════════════════════════════════════ -->
<Modal Title="上传文件"
       Visible="_showUpload"
       OnCancel="_ => CloseUploadIfIdle()"
       Footer="null"
       MaskClosable="false"
       Width="560"
       WrapClassName="apiextfs-upload-modal">
    @* Keep InputFile mounted while uploading; Blazor file streams are tied to this input.
       Wrap it so CSS isolation can't leave the native file control visible. *@
    <div class="apiextfs-upload-input-host" aria-hidden="true">
        <InputFile id="apiextfs-upload-input"
                   @ref="_inputFileRef"
                   OnChange="OnFilesSelected"
                   multiple
                   class="upload-file-input-hidden" />
    </div>

    @if (!_uploading)
    {
        <div class="apiextfs-upload-dropzone" role="button" tabindex="0"
             @onclick="TriggerFilePickerAsync"
             @onkeydown="OnUploadDropzoneKeyDown">
            <div class="apiextfs-upload-dropzone-icon">
                <Icon Type="cloud-upload" Theme="IconThemeType.Outline" />
            </div>
            <div class="apiextfs-upload-dropzone-title">点击选择文件，或拖放到页面任意位置</div>
            <div class="apiextfs-upload-dropzone-desc">
                支持多选。也可关闭弹窗后，直接把文件拖到列表页面上传。
            </div>
            <span class="ant-btn ant-btn-default apiextfs-upload-pick-btn">选择文件</span>
        </div>

        @if (_uploadQueue.Count > 0)
        {
            <div class="apiextfs-upload-summary">
                <span>已选择 <strong>@_uploadQueue.Count</strong> 个文件</span>
                <Button Type="@ButtonType.Link" Size="@ButtonSize.Small" OnClick="ClearUploadQueue">清空列表</Button>
            </div>

            <div class="upload-file-list">
                @foreach (var f in _uploadQueue)
                {
                    <div class="upload-file-row">
                        <span class="upload-file-icon">
                            <Icon Type="@ContentIcon(f.ContentType)" />
                        </span>
                        <span class="upload-file-name" title="@f.RelativePath">@f.RelativePath</span>
                        <span class="upload-file-size">@FormatSize(f.Size)</span>
                        <Button Type="@ButtonType.Text"
                                Danger
                                Icon="close"
                                Size="@ButtonSize.Small"
                                OnClick="() => RemoveUploadEntry(f)" />
                    </div>
                }
            </div>

            <div class="apiextfs-modal-footer">
                <Button OnClick="CloseUpload">取消</Button>
                <Button Type="@ButtonType.Primary" Icon="upload" OnClick="StartUploadAsync">
                    开始上传（@_uploadQueue.Count）
                </Button>
            </div>
        }
        else
        {
            <div class="apiextfs-modal-footer">
                <Button OnClick="CloseUpload">取消</Button>
            </div>
        }
    }
    else
    {
        <div class="apiextfs-upload-progress-head">
            <span>
                @if (_uploadDone)
                {
                    <text>上传完成</text>
                }
                else if (_uploadCancelled)
                {
                    <text>正在取消…</text>
                }
                else
                {
                    <text>正在上传…</text>
                }
            </span>
            <Space Size="@("12")">
                <SpaceItem>
                    <span class="apiextfs-upload-progress-meta">
                        @_uploadQueue.Count(f => f.Status is UploadStatus.Done) / @_uploadQueue.Count
                    </span>
                </SpaceItem>
                @if (!_uploadDone)
                {
                    <SpaceItem>
                        <Button Type="@ButtonType.Text"
                                Danger
                                Size="@ButtonSize.Small"
                                Icon="close-circle"
                                Disabled="_uploadCancelled"
                                OnClick="CancelUpload">
                            取消上传
                        </Button>
                    </SpaceItem>
                }
            </Space>
        </div>

        <div class="upload-file-list">
            @foreach (var f in _uploadQueue)
            {
                <div class="upload-file-row upload-file-row-progress">
                    <span class="upload-file-icon @StatusClass(f.Status)">
                        <Icon Type="@StatusIcon(f.Status)" Spin="@(f.Status == UploadStatus.Uploading)" />
                    </span>
                    <div class="upload-file-main">
                        <div class="upload-file-main-top">
                            <span class="upload-file-name" title="@f.RelativePath">@f.RelativePath</span>
                            <span class="upload-file-size @StatusClass(f.Status)">@StatusLabel(f.Status)</span>
                        </div>
                        @if (f.Status == UploadStatus.Uploading)
                        {
                            <Progress Percent="f.Progress" Size="@ProgressSize.Small" ShowInfo="false" />
                        }
                    </div>
                </div>
            }
        </div>

        @if (_uploadDone)
        {
            @if (_skippedFiles.Count > 0)
            {
                <Alert Type="@AlertType.Warning" ShowIcon="true" Class="apiextfs-mt-2"
                       Message="@("已跳过（没有更新权限）")">
                    <ChildContent>
                        <ul class="skipped-list">
                            @foreach (var s in _skippedFiles)
                            {
                                <li>@s</li>
                            }
                        </ul>
                    </ChildContent>
                </Alert>
            }
            <div class="apiextfs-modal-footer">
                <Button Type="@ButtonType.Primary" OnClick="CloseUploadAndRefresh">完成</Button>
            </div>
        }
    }
</Modal>

<!-- ══════════════════════════════════════════════════════════════════
     Overwrite confirmation modal
══════════════════════════════════════════════════════════════════ -->
<Modal Title="文件已存在"
       Visible="_overwriteFile is not null"
       Closable="false"
       MaskClosable="false"
       Footer="null">
    @if (_overwriteFile is not null)
    {
        <p><AntDesign.Text Strong>@_overwriteFile.RelativePath</AntDesign.Text> 已存在。</p>
        <div class="apiextfs-modal-footer">
            <Space Wrap>
                <SpaceItem>
                    <Button Type="@ButtonType.Primary" OnClick="() => ResolveOverwrite(OverwriteChoice.Overwrite)">覆盖</Button>
                </SpaceItem>
                <SpaceItem>
                    <Button OnClick="() => ResolveOverwrite(OverwriteChoice.OverwriteAll)">全部覆盖</Button>
                </SpaceItem>
                <SpaceItem>
                    <Button OnClick="() => ResolveOverwrite(OverwriteChoice.Skip)">跳过</Button>
                </SpaceItem>
                <SpaceItem>
                    <Button OnClick="() => ResolveOverwrite(OverwriteChoice.SkipAll)">全部跳过</Button>
                </SpaceItem>
            </Space>
        </div>
    }
</Modal>

<!-- ══════════════════════════════════════════════════════════════════
     Import from S3 modal
══════════════════════════════════════════════════════════════════ -->
<Modal Title="从 S3 导入"
       Visible="_showImportFromS3"
       OnCancel="_ => CloseImportFromS3()"
       Footer="null">
    @if (_modalError is not null)
    {
        <Alert Type="@AlertType.Error" Message="@_modalError" ShowIcon="true" Class="apiextfs-mb-2" />
    }
    @if (_importQueuedId is not null)
    {
        <Alert Type="@AlertType.Success" Message="@($"导入任务已加入队列：{_importQueuedId}")" ShowIcon="true" Class="apiextfs-mb-2" />
    }
    <div class="apiextfs-modal-form">
        <div class="apiextfs-form-item">
            <label>服务地址</label>
            <Input @bind-Value="_importServerUrl" Placeholder="https://s3.example.com" />
        </div>
        <div class="apiextfs-form-item">
            <label>用户名</label>
            <Input @bind-Value="_importUsername" Placeholder="Access key" />
        </div>
        <div class="apiextfs-form-item">
            <label>密钥</label>
            <InputPassword @bind-Value="_importKey" Placeholder="Secret key" />
        </div>
        <div class="apiextfs-form-item">
            <label>Bucket 名称</label>
            <Input @bind-Value="_importSourceBucket" Placeholder="source-bucket" />
        </div>
        <div class="apiextfs-form-item">
            <label>重复对象</label>
            <Select @bind-Value="_importDuplicateMode" TItemValue="string" TItem="string" Style="width:100%">
                <SelectOptions>
                    <SelectOption TItemValue="string" TItem="string" Value="@("Overwrite")" Label="覆盖" />
                    <SelectOption TItemValue="string" TItem="string" Value="@("Skip")" Label="跳过" />
                    <SelectOption TItemValue="string" TItem="string" Value="@("Rename")" Label="重命名" />
                </SelectOptions>
            </Select>
        </div>
    </div>
    <div class="apiextfs-modal-footer">
        <Space>
            <SpaceItem>
                <Button Type="@ButtonType.Primary" OnClick="QueueImportFromS3Async" Loading="_importQueueing">加入导入队列</Button>
            </SpaceItem>
            <SpaceItem>
                <Button OnClick="CloseImportFromS3">关闭</Button>
            </SpaceItem>
        </Space>
    </div>
</Modal>

