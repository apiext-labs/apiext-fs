@page "/_apiextfs/setup"
@layout AuthLayout
@using Microsoft.EntityFrameworkCore
@inject IDbContextFactory<Apiext.Fs.Data.AppDbContext> DbFactory
@inject IConfiguration Config
@inject NavigationManager Nav

@code {
    [SupplyParameterFromQuery] public string? Error { get; set; }

    protected override async Task OnInitializedAsync()
    {
        // Setup only available when static account is disabled and no DB users exist
        var staticAllowed = Config.GetValue<bool>("UseStaticAccount") && !string.IsNullOrEmpty(Config.GetValue<string?>("StaticUser"));
        if (staticAllowed)
        {
            Nav.NavigateTo("/_apiextfs/login", replace: true);
            return;
        }

        await using var db = await DbFactory.CreateDbContextAsync();
        if (await db.Users.AnyAsync())
            Nav.NavigateTo("/_apiextfs/login", replace: true);
    }

    // The form is a plain HTML POST (/_apiextfs/auth/setup) so the server can create
    // the first account and redirect. AntDesign inputs do not expose form attributes,
    // so name/id/required are forwarded through their unmatched-attribute bag.
    private static readonly Dictionary<string, object> _usernameAttrs = new()
    {
        ["id"] = "Username",
        ["name"] = "Username",
        ["required"] = true
    };

    private static readonly Dictionary<string, object> _passwordAttrs = new()
    {
        ["id"] = "Password",
        ["name"] = "Password",
        ["required"] = true
    };

    private static readonly Dictionary<string, object> _confirmAttrs = new()
    {
        ["id"] = "Confirm",
        ["name"] = "Confirm",
        ["required"] = true
    };
}

<PageTitle>初始化设置 — Apiext.Fs</PageTitle>

<div class="apiextfs-user-card">
    <div class="apiextfs-user-form-title">创建管理员账号</div>
    <div class="apiextfs-user-form-desc">当前还没有用户，请先创建第一个超级管理员账号。</div>

    @if (Error == "empty")
    {
        <Alert Type="@AlertType.Error"
               Message="用户名和密码不能为空。"
               ShowIcon="true"
               Class="apiextfs-user-alert" />
    }
    else if (Error == "mismatch")
    {
        <Alert Type="@AlertType.Error"
               Message="两次输入的密码不一致。"
               ShowIcon="true"
               Class="apiextfs-user-alert" />
    }

    <form method="post" action="/_apiextfs/auth/setup" class="apiextfs-user-form" autocomplete="on">
        <div class="apiextfs-user-field">
            <label class="apiextfs-user-label" for="Username">用户名</label>
            <Input TValue="string"
                   @attributes="_usernameAttrs"
                   Placeholder="请输入用户名"
                   AutoFocus />
        </div>

        <div class="apiextfs-user-field">
            <label class="apiextfs-user-label" for="Password">密码</label>
            <InputPassword @attributes="_passwordAttrs"
                           Placeholder="请输入密码" />
        </div>

        <div class="apiextfs-user-field">
            <label class="apiextfs-user-label" for="Confirm">确认密码</label>
            <InputPassword @attributes="_confirmAttrs"
                           Placeholder="请再次输入密码" />
        </div>

        <Button Type="@ButtonType.Primary"
                HtmlType="submit"
                Block
                Class="apiextfs-user-submit">
            创建账号
        </Button>
    </form>
</div>
