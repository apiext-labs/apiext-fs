@page "/_apiextfs/credentials"
@layout AppLayout
@attribute [Microsoft.AspNetCore.Authorization.Authorize]
@using System.Security.Claims
@inject IPresignedUrlService Presign
@inject NavigationManager Nav

<PageTitle>凭据 - Apiext.Fs</PageTitle>

<PageContainer Title="凭据">
    <Content>
        <AntDesign.Text Type="@TextElementType.Secondary">
            你的 S3 兼容 API 凭据。Access Key 使用登录用户名，Secret 使用登录密码。
        </AntDesign.Text>
    </Content>
    <ChildContent>
        <div class="apiextfs-stack">
            <Card Title="S3 API 凭据">
                <div class="apiextfs-mb-2">
                    <Text Type="@TextElementType.Secondary">
                        配置任意 S3 兼容客户端时使用以下信息。Access Key 使用登录用户名，Secret 使用登录密码。
                    </Text>
                </div>
                <Descriptions Column="1" Bordered Size="@DescriptionsSize.Middle">
                    <DescriptionsItem Title="端点"><Text Code>@_endpoint</Text></DescriptionsItem>
                    <DescriptionsItem Title="Access Key ID"><Text Code>@_username</Text></DescriptionsItem>
                    <DescriptionsItem Title="Secret Access Key">
                        <Space>
                            <SpaceItem><Text Code>@(_showSecret ? _secret : "••••••••••••")</Text></SpaceItem>
                            <SpaceItem>
                                <Button Size="@ButtonSize.Small" OnClick="() => _showSecret = !_showSecret">
                                    @(_showSecret ? "隐藏" : "显示")
                                </Button>
                            </SpaceItem>
                        </Space>
                    </DescriptionsItem>
                    <DescriptionsItem Title="区域">
                        <Text Code>us-east-1</Text>
                        <Text Type="@TextElementType.Secondary">（任意值均可）</Text>
                    </DescriptionsItem>
                    <DescriptionsItem Title="签名版本">SigV4 或 SigV2</DescriptionsItem>
                    <DescriptionsItem Title="路径风格">已启用（同时支持虚拟主机风格）</DescriptionsItem>
                </Descriptions>
            </Card>

            <Card Title="生成预签名 URL">
                <Form Model="_ps" Layout="@FormLayout.Vertical" OnFinish="GeneratePresignAsync">
                    <Row Gutter="16">
                        <AntDesign.Col Xs="24" Sm="12" Md="6">
                            <FormItem Label="Bucket">
                                <AntDesign.Input @bind-Value="context.Bucket" Placeholder="my-bucket" />
                            </FormItem>
                        </AntDesign.Col>
                        <AntDesign.Col Xs="24" Sm="12" Md="6">
                            <FormItem Label="对象 Key">
                                <AntDesign.Input @bind-Value="context.Key" Placeholder="path/to/file.txt" />
                            </FormItem>
                        </AntDesign.Col>
                        <AntDesign.Col Xs="24" Sm="12" Md="6">
                            <FormItem Label="方法">
                                <Select @bind-Value="context.Method" TItemValue="string" TItem="string" Style="width:100%">
                                    <SelectOptions>
                                        <SelectOption TItemValue="string" TItem="string" Value="@("GET")" Label="GET（下载）" />
                                        <SelectOption TItemValue="string" TItem="string" Value="@("PUT")" Label="PUT（上传）" />
                                    </SelectOptions>
                                </Select>
                            </FormItem>
                        </AntDesign.Col>
                        <AntDesign.Col Xs="24" Sm="12" Md="6">
                            <FormItem Label="过期时间（秒）">
                                <AntDesign.InputNumber @bind-Value="context.Expires" Min="60" Max="604800" Style="width:100%" />
                            </FormItem>
                        </AntDesign.Col>
                    </Row>
                    @if (_psError is not null)
                    {
                        <Alert Type="@AlertType.Error" Message="@_psError" ShowIcon="true" Class="apiextfs-mb-2" />
                    }
                    <FormItem>
                        <Button Type="@ButtonType.Primary" HtmlType="submit">生成</Button>
                    </FormItem>
                </Form>

                @if (_psUrl is not null)
                {
                    <div class="apiextfs-mt-2">
                        <FormItem Label="@($"预签名 URL（{_ps.Expires} 秒后过期）")">
                            <AntDesign.Input Value="@_psUrl" ReadOnly />
                        </FormItem>
                    </div>
                }
            </Card>
        </div>
    </ChildContent>
</PageContainer>

@code {
    [CascadingParameter] private Task<AuthenticationState>? AuthState { get; set; }

    private string _username = string.Empty;
    private string _secret   = string.Empty;
    private string _endpoint = string.Empty;
    private bool   _showSecret;

    private readonly PresignModel _ps = new();
    private string? _psUrl;
    private string? _psError;

    private bool _isSuperAdmin;
    private string _userId = string.Empty;

    private sealed class PresignModel
    {
        public string Bucket { get; set; } = string.Empty;
        public string Key { get; set; } = string.Empty;
        public string Method { get; set; } = "GET";
        public int Expires { get; set; } = 3600;
    }

    protected override async Task OnInitializedAsync()
    {
        _endpoint = new Uri(Nav.BaseUri).GetLeftPart(UriPartial.Authority);

        if (AuthState is not null)
        {
            var state = await AuthState;
            var user  = state.User;
            _username    = user.Identity?.Name ?? string.Empty;
            // Cookie auth stores super-admin as custom claim, not ASP.NET role.
            _isSuperAdmin = user.FindFirstValue("is_super_admin") == "true";
            _userId      = user.FindFirstValue(ClaimTypes.NameIdentifier) ?? string.Empty;

            // Password is not kept after login — Secret Key is the login password.
            _secret = "（登录密码）";
        }
    }

    private async Task GeneratePresignAsync()
    {
        _psError = null;
        _psUrl = null;

        if (string.IsNullOrWhiteSpace(_ps.Bucket))
        {
            _psError = "Bucket 不能为空。";
            return;
        }

        if (string.IsNullOrWhiteSpace(_ps.Key))
        {
            _psError = "对象 Key 不能为空。";
            return;
        }

        if (_ps.Expires < 1)
        {
            _psError = "过期时间至少为 1 秒。";
            return;
        }

        try
        {
            var token = Presign.Create(
                _ps.Method,
                _ps.Bucket.Trim(),
                _ps.Key.Trim(),
                _userId,
                _username,
                _isSuperAdmin,
                _ps.Expires);

            _psUrl = $"{_endpoint}/{_ps.Bucket.Trim()}/{_ps.Key.Trim()}?X-Apiext-Fs-Presign={Uri.EscapeDataString(token.Token)}";
        }
        catch (Exception ex)
        {
            _psError = ex.Message;
        }

        await Task.CompletedTask;
    }
}
