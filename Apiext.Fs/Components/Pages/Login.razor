@page "/_apiextfs/login"
@layout AuthLayout
@rendermode InteractiveServer
@using Microsoft.EntityFrameworkCore
@using Microsoft.AspNetCore.Components.Web
@inject IDbContextFactory<Apiext.Fs.Data.AppDbContext> DbFactory
@inject IConfiguration Config
@inject NavigationManager Nav
@inject IJSRuntime JS

@code {
    [SupplyParameterFromQuery] public string? Error { get; set; }
    [SupplyParameterFromQuery] public string? Created { get; set; }
    [SupplyParameterFromQuery] public string? ReturnUrl { get; set; }

    private bool _staticAllowed;
    private bool _hasDbUsers;

    private string _username = string.Empty;
    private string _password = string.Empty;
    private bool _submitting;
    private string? _validationError;

    protected override async Task OnInitializedAsync()
    {
        _staticAllowed = Config.GetValue<bool>("UseStaticAccount") && !string.IsNullOrEmpty(Config.GetValue<string?>("StaticUser"));

        await using var db = await DbFactory.CreateDbContextAsync();
        _hasDbUsers = await db.Users.AnyAsync();

        // If no static account and no DB users → redirect to setup
        if (!_staticAllowed && !_hasDbUsers)
            Nav.NavigateTo("/_apiextfs/setup", replace: true);
    }

    private async Task LoginAsync()
    {
        if (_submitting) return;

        if (string.IsNullOrWhiteSpace(_username) || string.IsNullOrEmpty(_password))
        {
            _validationError = "请输入用户名和密码。";
            return;
        }

        _validationError = null;
        _submitting = true;

        // Real form POST so the server can issue the auth cookie.
        await JS.InvokeVoidAsync("apiextfsSubmitLogin", _username, _password, ReturnUrl ?? string.Empty);
    }

    private Task OnEnterPressed(KeyboardEventArgs args)
        => args.Key is "Enter" or "NumpadEnter" ? LoginAsync() : Task.CompletedTask;
}

<PageTitle>登录 - Apiext.Fs</PageTitle>

<div class="apiextfs-user-card">
    @if (Created == "1")
    {
        <Alert Type="@AlertType.Success"
               Message="管理员账号已创建，请登录。"
               ShowIcon="true"
               Class="apiextfs-user-alert" />
    }
    @if (Error == "1")
    {
        <Alert Type="@AlertType.Error"
               Message="用户名或密码不正确。"
               ShowIcon="true"
               Class="apiextfs-user-alert" />
    }
    @if (_validationError is not null)
    {
        <Alert Type="@AlertType.Error"
               Message="@_validationError"
               ShowIcon="true"
               Class="apiextfs-user-alert" />
    }

    <div class="apiextfs-user-form">
        <div class="apiextfs-user-field">
            <label class="apiextfs-user-label" for="Username">用户名</label>
            <Input @bind-Value="_username"
                   Placeholder="Access Key / 用户名"
                   AutoFocus
                   Disabled="_submitting"
                   OnPressEnter="OnEnterPressed" />
        </div>

        <div class="apiextfs-user-field">
            <label class="apiextfs-user-label" for="Password">密码</label>
            <InputPassword @bind-Value="_password"
                           Placeholder="Secret Key / 密码"
                           Disabled="_submitting"
                           OnPressEnter="OnEnterPressed" />
        </div>

        <Button Type="@ButtonType.Primary"
                Block
                Class="apiextfs-user-submit"
                Loading="_submitting"
                OnClick="LoginAsync">
            登录
        </Button>
    </div>
</div>
