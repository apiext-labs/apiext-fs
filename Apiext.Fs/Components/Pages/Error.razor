@page "/_apiextfs/Error"
@using System.Diagnostics
@inject NavigationManager Nav

<PageTitle>错误 — Apiext.Fs</PageTitle>

<div class="apiextfs-result-center">
    <Result Status="@ResultStatus.Error"
            Title="处理请求时发生错误"
            SubTitle="服务器在处理该请求时抛出异常，请稍后重试或联系管理员。">
        <Extra>
            <Button Type="@ButtonType.Primary" OnClick="GoHome">返回概览</Button>
        </Extra>
        <ChildContent>
            <div class="apiextfs-error-note">
                <Alert Type="@AlertType.Info"
                       ShowIcon="true"
                       Message="开发模式可显示详细错误信息"
                       Description="在 Development 环境下运行可看到完整异常堆栈；已部署环境请勿启用，避免向最终用户泄露敏感信息。" />
                @if (ShowRequestId)
                {
                    <div class="apiextfs-error-request-id">
                        <AntDesign.Text Type="@TextElementType.Secondary">
                            请求 ID：<AntDesign.Text Code>@RequestId</AntDesign.Text>
                        </AntDesign.Text>
                    </div>
                }
            </div>
        </ChildContent>
    </Result>
</div>

@code{
    [CascadingParameter]
    private HttpContext? HttpContext { get; set; }

    private string? RequestId { get; set; }
    private bool ShowRequestId => !string.IsNullOrEmpty(RequestId);

    protected override void OnInitialized() =>
        RequestId = Activity.Current?.Id ?? HttpContext?.TraceIdentifier;

    private void GoHome() => Nav.NavigateTo("/_apiextfs");
}
